# Build artifacts
node_modules/
dist/
build/
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Backups (creados por install-global.sh)
.skalling-backups/

# Python
__pycache__/
*.pyc
.venv/

# Test artifacts
coverage/
.nyc_output/

# TeamDB: la DB cruda no se commitea; git guarda el export .sql (.opencode/context/teamdb/)
.opencode/context/team.db
.opencode/context/team.db-shm
.opencode/context/team.db-wal
.opencode/context/team.db.pre-migration-*
.opencode/context/.pre-migration-*
.opencode/context/.backup-*
.opencode/context/.backups/
.opencode/context/.legacy-backup-*
# Export local del pre-commit (data_*.sql) y bundles de review --deep: output efímero
.opencode/context/teamdb/
.opencode/context/review/

# Índice local de CodeGraph (generado por gentile-ai codegraph init)
.codegraph/

# Cambios efímeros (no son código, son output de ejecución)
.opencode/changes/**/insert-proposal.sql
.opencode/changes/**/receipts/
.opencode/changes/**/logs/
.atl/
.opencode/context/.pre-preference-edit-*.db

# TeamDB locks (flock para evitar race conditions entre agentes)
.opencode/context/team.lock
.opencode/context/*.lock
