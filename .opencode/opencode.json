{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": { ".opencode/**": "allow", "/var/folders/**": "deny", "/tmp/**": "deny" },
    "todowrite": {
      "/var/folders/**": "deny",
      "/tmp/**": "deny",
      "/private/tmp/**": "deny",
      "*": "allow"
    },
    "bash": {
      "find *": "allow",
      "head *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "git *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "xargs *": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "bash *": "allow",
      "sh *": "allow",
      "realpath *": "allow",
      "mktemp *": "allow",
      "curl *": "allow",
      "nc *": "allow",
      "xxd *": "allow",
      "shasum *": "allow",
      "sqlite3 *": "allow",
      "*": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  }
}
