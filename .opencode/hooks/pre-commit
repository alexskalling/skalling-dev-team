#!/usr/bin/env bash
# skalling-hook: marca para que el instalador reconozca este hook como propio.
# Read-only gate: never repairs DB, creates receipts, or stages a dump.
set -euo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# HOOK_DIR resuelve a .git/hooks (la ruta del symlink, no su destino real) --
# "$HOOK_DIR/../hooks/git-gate.py" era el mismo .git/hooks de vuelta, nunca
# encontraba nada. git rev-parse --show-toplevel es la unica forma confiable
# de llegar al repo real sin importar como bash resolvio BASH_SOURCE.
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# Hook previo del proyecto: el instalador no lo borra, lo conserva como
# <hook>.skalling-prev y acá se encadena. Corre primero; si falla, Git se
# detiene igual que antes de instalar Skalling.
HOOKS_PATH="$(git rev-parse --git-path hooks)"
PREV_HOOK="${HOOKS_PATH:+$HOOKS_PATH/pre-commit.skalling-prev}"
if [ -n "$PREV_HOOK" ] && [ -x "$PREV_HOOK" ]; then
  "$PREV_HOOK" "$@"
fi
GATES=(
  "$HOOK_DIR/git-gate.py"
  "${TOPLEVEL:+$TOPLEVEL/.opencode/hooks/git-gate.py}"
  "${SKALLING_ROOT:-}/scripts/hooks/git-gate.py"
  "${SKALLING_OPENCODE_DIR:-$HOME/.config/opencode}/hooks/git-gate.py"
)
for gate in "${GATES[@]}"; do
  if [ -n "$gate" ] && [ -f "$gate" ]; then
    exec python3 "$gate" pre-commit
  fi
done
echo "ERROR: git-gate.py no encontrado. Reinstalar hooks Skalling; no modificar TeamDB." >&2
exit 1
