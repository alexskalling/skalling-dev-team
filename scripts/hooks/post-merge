#!/usr/bin/env bash
# post-merge hook: import .sql files to teamdb
# Errors son visibles (no suprimidos) — la salud de teamdb es importante.
PROJECT="$(git rev-parse --show-toplevel)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -d "$PROJECT/.opencode/context/teamdb" ]; then
  bash "$SCRIPT_DIR/../teamdb-import.sh" "$PROJECT"
  echo "teamdb: imported .sql from git"
fi
