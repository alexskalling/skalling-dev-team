#!/usr/bin/env bash
# skalling-hook: marca para que el instalador reconozca este hook como propio.
# post-merge hook: mergea el dump versionado (git) hacia la DB local por fila.
# FASE 0: la DB es la fuente de la verdad; tras un pull, el dump de la otra
# máquina se fusiona en la DB local (INSERTs nuevos + último-write-gana).
# Errores son visibles — la salud de teamdb es importante.
set -euo pipefail

PROJECT="$(git rev-parse --show-toplevel)"

# Hook previo del proyecto: el instalador no lo borra, lo conserva como
# <hook>.skalling-prev y acá se encadena. Corre primero; si falla, Git se
# detiene igual que antes de instalar Skalling.
HOOKS_PATH="$(git rev-parse --git-path hooks)"
PREV_HOOK="${HOOKS_PATH:+$HOOKS_PATH/post-merge.skalling-prev}"
if [ -n "$PREV_HOOK" ] && [ -x "$PREV_HOOK" ]; then
  "$PREV_HOOK" "$@"
fi

# Fail-open: sin dump versionado no hay nada que mergear (repo sin Fase 0).
[ -f "$PROJECT/db/teamdb/team.dump.sql" ] || exit 0

GLOBAL_SCRIPT="${SKALLING_ROOT:-$HOME/.config/opencode}/scripts/teamdb-merge.sh"
REPO_SCRIPT="$PROJECT/scripts/teamdb-merge.sh"
LOCAL_SCRIPT="$PROJECT/.opencode/scripts/teamdb-merge.sh"

if [ -x "$LOCAL_SCRIPT" ]; then
  bash "$LOCAL_SCRIPT" "$PROJECT" || {
    echo "[ERROR] teamdb-merge.sh falló. El merge continúa, pero teamdb puede estar desincronizado." >&2
    exit 1
  }
elif [ -x "$GLOBAL_SCRIPT" ]; then
  bash "$GLOBAL_SCRIPT" "$PROJECT" || {
    echo "[ERROR] teamdb-merge.sh falló. El merge continúa, pero teamdb puede estar desincronizado." >&2
    exit 1
  }
elif [ -x "$REPO_SCRIPT" ]; then
  bash "$REPO_SCRIPT" "$PROJECT" || {
    echo "[ERROR] teamdb-merge.sh falló." >&2
    exit 1
  }
else
  echo "[WARN] teamdb-merge.sh no encontrado" >&2
  exit 0
fi

echo "teamdb: dump mergeado hacia la DB local"
