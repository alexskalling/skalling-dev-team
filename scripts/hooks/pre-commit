#!/usr/bin/env bash
# pre-commit hook: export teamdb data to .sql
set -euo pipefail

PROJECT="$(git rev-parse --show-toplevel)"

# Salir silenciosamente si no hay teamdb proyecto
[ -f "$PROJECT/.opencode/context/team.db" ] || exit 0

# Preferir install global; fallback al repo
GLOBAL_SCRIPT="${SKALLING_ROOT:-$HOME/.config/opencode}/scripts/teamdb-export.sh"
REPO_SCRIPT="$PROJECT/scripts/teamdb-export.sh"

if [ -x "$GLOBAL_SCRIPT" ]; then
  bash "$GLOBAL_SCRIPT" "$PROJECT"
elif [ -x "$REPO_SCRIPT" ]; then
  bash "$REPO_SCRIPT" "$PROJECT"
else
  echo "[WARN] teamdb-export.sh no encontrado (global: $GLOBAL_SCRIPT, repo: $REPO_SCRIPT)" >&2
  exit 0
fi

SQL_FILES=$(ls "$PROJECT/.opencode/context/teamdb"/data_*.sql 2>/dev/null) || true
if [ -n "$SQL_FILES" ]; then
  # shellcheck disable=SC2086
  git add $SQL_FILES
fi

# Validar que haya receipts recientes para cambios importantes
DB="$(git rev-parse --show-toplevel)/.opencode/context/team.db"
if [ -f "$DB" ]; then
  # Si hay tasks in_progress sin receipt reciente, fallar
  HAS_INCOMPLETE=$(sqlite3 "$DB" "SELECT COUNT(*) FROM tasks WHERE status='in_progress'" 2>/dev/null || echo 0)
  if [ "$HAS_INCOMPLETE" -gt 0 ]; then
    echo "WARN: hay $HAS_INCOMPLETE task(s) in_progress sin cerrar" >&2
    echo "      Corré: sqlite3 $DB \"UPDATE tasks SET status='resolved' WHERE status='in_progress'\"" >&2
  fi
fi
