#!/usr/bin/env bash
# Read-only gate: never repairs DB, creates receipts, or stages a dump.
set -euo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for gate in "$HOOK_DIR/git-gate.py" "$HOOK_DIR/../hooks/git-gate.py" "${SKALLING_ROOT:-}/scripts/hooks/git-gate.py" "${SKALLING_OPENCODE_DIR:-$HOME/.config/opencode}/hooks/git-gate.py"; do
  if [ -f "$gate" ]; then
    exec python3 "$gate" pre-commit
  fi
done
echo "ERROR: git-gate.py no encontrado. Reinstalar hooks Skalling; no modificar TeamDB." >&2
exit 1
