#!/usr/bin/env bash
# pre-commit hook: RDD + fail-closed validation + recepción inmutable (v0.8.3)
# Verifica receipts + tasks in_progress + tree_hash del candidato antes de commitear
set -euo pipefail
PROJECT="$(git rev-parse --show-toplevel)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DB="$PROJECT/.opencode/context/team.db"

# BEGIN-TO-EPOCH
# to_epoch <"YYYY-MM-DD HH:MM:SS"> → epoch. El timestamp del receipt sale de
# sqlite datetime('now'), que guarda UTC. GNU date -d vs la flag BSD date -j: se
# detecta el flavor UNA vez. Sin esto, Linux CI (GNU sin la flag BSD) devolvía 0 →
# AGE>600 → commits bloqueados en CI pese a receipts frescos. Y parsear como hora
# LOCAL corría el epoch por el offset de TZ: en TZ positiva un receipt fresco se
# veía FUTURO (AGE negativo → bloqueaba) y en TZ negativa daba horas de ventana.
# POR ESO ambas ramas parsean UTC (mismo criterio que lib-memory-check.sh:97).
if date --version >/dev/null 2>&1; then
  # GNU: sufijo " UTC" (el formato de sqlite no lleva zona horaria).
  to_epoch() { date -d "$1 UTC" +%s; }
else
  # BSD: -u fuerza UTC; sin -u interpretaba hora local.
  to_epoch() { date -j -u -f "%Y-%m-%d %H:%M:%S" "$1" +%s; }
fi
# END-TO-EPOCH

# Fail-closed: si DB no existe, no fallar (init aún no se ejecutó)
if [ ! -f "$DB" ]; then
  exit 0
fi

# 0. ENFORCEMENT: DB es la única fuente de verdad. Bloquear commits que escriban
#    .md como fuente en .opencode/changes/ (excepto archive), decisiones, problemas, followups.
#    Los .md en esas rutas son EXPORTS derivados de la DB, nunca la fuente.
CHANGED_MD_SOURCE=$(git diff --cached --name-only | grep -v '/archive/' | grep -E '\.opencode/(changes|context/decisiones|context/problemas-conocidos|context/followups)/.*\.md$' || true)
if [ -n "$CHANGED_MD_SOURCE" ]; then
  echo "ERROR: committing .md as source of truth is forbidden." >&2
  echo "       DB is the ONLY source of truth. These files are exports, not source:" >&2
  echo "$CHANGED_MD_SOURCE" | while read -r f; do echo "         - $f" >&2; done
  echo "       USE: teamdb-plan.sh (proposals/plans) | teamdb-export-md.sh (exports)" >&2
  echo "       IF the .md was created by a script (e.g. teamdb-export-md.sh), it must have" >&2
  echo "       a matching row in the DB (proposals.slug, decisions.slug, etc)." >&2
  exit 1
fi

# 0b. Excepciones: skills/*.md, command/*.md, docs/*.md, constitution/*.md, README, CHANGELOG
EXEMPT_MD=$(git diff --cached --name-only | grep -E '^((skills|command|docs|constitution|tests?)/.*\.md|README\.md|CHANGELOG\.md|\.md)$' || true)
if [ -n "$EXEMPT_MD" ]; then
  : # these are exempt from the MD source-of-truth rule
fi

# 1. Validar que no haya tasks in_progress sin cerrar (warn, no fail)
TASKS_IN_PROGRESS=$(sqlite3 "$DB" "SELECT COUNT(*) FROM tasks WHERE status='in_progress'" 2>/dev/null || echo 0)
if [ "$TASKS_IN_PROGRESS" -gt 0 ]; then
  echo "WARN: hay $TASKS_IN_PROGRESS task(s) in_progress sin cerrar" >&2
  echo "      Sugerencia: sqlite3 $DB \"UPDATE tasks SET status='resolved' WHERE status='in_progress'\"" >&2
fi

# 2. Validar que el último commit tenga receipt reciente (fail si no)
# Si hay cambios en código (no solo docs), exigir receipt
CHANGED_CODE=$(git diff --cached --name-only | grep -cE "\.(ts|tsx|js|jsx|py|rs|go|java|cpp|c|sh|bash)$" || true)
if [ "$CHANGED_CODE" -gt 0 ]; then
  LAST_RECEIPT=$(sqlite3 "$DB" "SELECT ts FROM receipts ORDER BY ts DESC LIMIT 1" 2>/dev/null || echo "")
  if [ -z "$LAST_RECEIPT" ]; then
    echo "ERROR: hay cambios en código pero no hay receipts en DB" >&2
    echo "       Corré un test que cree un receipt primero." >&2
    exit 1
  fi
  # Verificar que el receipt es reciente (< 10 min)
  LAST_TS_EPOCH=$(to_epoch "$LAST_RECEIPT" 2>/dev/null || echo 0)
  NOW_EPOCH=$(date +%s)
  AGE=$((NOW_EPOCH - LAST_TS_EPOCH))
  if [ "$AGE" -gt 600 ]; then
    echo "ERROR: el último receipt tiene más de 10 minutos" >&2
    echo "       Corré tests recientes para crear receipts frescos." >&2
    exit 1
  fi

  # 2b. v0.8.3: inmutabilidad — el árbol staged debe coincidir con el último
  # receipt sellado (tree_hash). El hash se calcula ANTES del export (el export
  # escribe data_*.sql en el working tree, ajenos a la revisión sellada).
  # FASE 0: el dump versionado (db/teamdb/team.dump.sql) también se excluye del
  # hash — es un artefacto derivado de la DB, no código revisado; se regenera
  # en el paso 3 y se stagea después del check de inmutabilidad.
  # Si una línea cambió después de la revisión, se bloquea hasta re-sellar.
  CURRENT_HASH=""
  if git -C "$PROJECT" rev-parse --verify HEAD >/dev/null 2>&1; then
    DIFF_TEXT="$(git -C "$PROJECT" diff HEAD -- . ':(exclude)db/teamdb/team.dump.sql' 2>/dev/null || DIFF_TEXT="")"
    if [ -n "$DIFF_TEXT" ]; then
      CURRENT_HASH="$(printf '%s' "$DIFF_TEXT" | shasum -a 256 | cut -c1-16)"
    else
      # v0.8.3 (bug D): este branch (árbol idéntico a HEAD → hash de HEAD) es
      # inalcanzable en la práctica: se llega acá solo si CHANGED_CODE>0, que
      # implica `git diff --cached` no vacío → `git diff HEAD` es no vacío.
      # Se mantiene por defensa; un commit sin cambios es un no-op que git
      # rechaza igual (el seal sí bloquea el caso, ver teamdb-seal-receipt.sh).
      CURRENT_HASH="$(git -C "$PROJECT" rev-parse HEAD | cut -c1-16)"
    fi
  else
    DIFF_TEXT="$(git -C "$PROJECT" diff --cached -- . ':(exclude)db/teamdb/team.dump.sql' 2>/dev/null || DIFF_TEXT="")"
    if [ -n "$DIFF_TEXT" ]; then
      CURRENT_HASH="$(printf '%s' "$DIFF_TEXT" | shasum -a 256 | cut -c1-16)"
    fi
  fi

  LAST_TREE_HASH=$(sqlite3 "$DB" "SELECT tree_hash FROM receipts WHERE tree_hash IS NOT NULL AND tree_hash != '' ORDER BY ts DESC LIMIT 1" 2>/dev/null || echo "")
  if [ -n "$LAST_TREE_HASH" ] && [ -n "$CURRENT_HASH" ] && [ "$LAST_TREE_HASH" != "$CURRENT_HASH" ]; then
    echo "ERROR: el árbol staged cambió desde el receipt de revisión (seal)." >&2
    echo "       Corré bash scripts/teamdb-seal-receipt.sh <task> <agent> para re-sellar" >&2
    echo "       o revertí los cambios no revisados." >&2
    exit 1
  fi
fi

# 3. FASE 0: regenerar el dump versionado (db/teamdb/team.dump.sql) y stagearlo.
# Reemplaza el export data_*.sql a .opencode/context/teamdb/ (gitignored, muerto).
# El dump es la fotografía de la DB; se actualiza en cada commit para que git
# guarde la copia más reciente. Si la DB no cambió, el dump queda byte-idéntico
# (determinista) → git add es no-op.
DUMP_SCRIPT=""
for candidate in \
  "${SKALLING_ROOT:-}/scripts/teamdb-dump.sh" \
  "$SCRIPT_DIR/teamdb-dump.sh" \
  "$PROJECT/scripts/teamdb-dump.sh"; do
  if [ -f "$candidate" ]; then
    DUMP_SCRIPT="$candidate"
    break
  fi
done
if [ -n "$DUMP_SCRIPT" ] && [ -f "$PROJECT/.opencode/context/team.db" ]; then
  if bash "$DUMP_SCRIPT" "$PROJECT" >/dev/null 2>&1; then
    if [ -f "$PROJECT/db/teamdb/team.dump.sql" ]; then
      git add "$PROJECT/db/teamdb/team.dump.sql" 2>/dev/null || true
    fi
  else
    # El dump puede fallar por secretos detectados (fail-closed): el commit NO
    # debe avanzar con un estado que no se puede fotografiar.
    echo "ERROR: teamdb-dump falló (posible secreto en la DB). Corregí y reintentá." >&2
    exit 1
  fi
fi

exit 0
