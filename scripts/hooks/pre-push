#!/usr/bin/env bash
# pre-push hook: gates sobre lo que se va a publicar (v0.9 Fase 1)
# 1) Gate barato O(1): el dump versionado db/teamdb/team.dump.sql debe estar
#    FRESCO — regenerado en memoria y comparado por hash con el del working
#    tree. Si la DB local cambió y el dump no se refrescó, bloquea (un script
#    de escritura no corrió su teamdb_refresh_dump, o falló silenciosamente).
# 2) Gate de inmutabilidad: el diff congelado (merge-base..local_sha) de CADA
#    ref a pushear debe coincidir con el último receipt sellado (tree_hash),
#    EXCLUYENDO db/teamdb/team.dump.sql (artefacto derivado, mismo pathspec
#    que pre-commit y teamdb-seal-receipt.sh). Fail-closed.
set -euo pipefail
PROJECT="$(git rev-parse --show-toplevel)"
DB="$PROJECT/.opencode/context/team.db"
DUMP="$PROJECT/db/teamdb/team.dump.sql"

# Resolver el script de dump con cascada (producción: el del proyecto; tests o
# hooks instalados en otro repo: el que vive junto al hook).
DUMP_SCRIPT=""
for candidate in \
  "$PROJECT/scripts/teamdb-dump.sh" \
  "$(dirname "$(dirname "$0")")/teamdb-dump.sh"; do
  if [ -f "$candidate" ]; then
    DUMP_SCRIPT="$candidate"
    break
  fi
done

# Fail-open, mismo guard que post-merge/pre-commit: sin dump versionado no hay
# nada que verificar aún (repo sin Fase 0).
[ -f "$DUMP" ] || exit 0
# Fail-open: sin DB no hay receipts ni dump fresco que comparar.
[ -f "$DB" ] || exit 0

is_zero_sha() {
  [[ "$1" =~ ^0+$ ]]
}

FAILED=0

# ── Gate barato (Fase 1): el dump debe reflejar la DB local ──
# Regenerar a STDOUT (sin tocar el working tree) y comparar hash contra el
# dump del working tree. Diferencia ⇒ DB mutada sin refresh post-escritura.
if [ -n "$DUMP_SCRIPT" ]; then
  TMP_DUMP="$(mktemp "${TMPDIR:-/tmp}/teamdb-push-dump.XXXXXX.sql")"
  if bash "$DUMP_SCRIPT" "$PROJECT" --stdout >"$TMP_DUMP" 2>/dev/null; then
    FRESH_HASH="$(shasum -a 256 "$TMP_DUMP" | cut -c1-16)"
    CUR_HASH="$(shasum -a 256 "$DUMP" | cut -c1-16)"
    if [ "$FRESH_HASH" != "$CUR_HASH" ]; then
      echo "ERROR: [pre-push] el dump versionado está DESACTUALIZADO." >&2
      echo "       La DB local cambió pero db/teamdb/team.dump.sql no la refleja." >&2
      echo "       Regeneralo antes de pushear: bash scripts/teamdb-dump.sh $PROJECT" >&2
      echo "       (recibido: $CUR_HASH, esperado fresco: $FRESH_HASH)" >&2
      FAILED=1
    fi
    echo "OK: [pre-push] dump fresco (hash $FRESH_HASH)"
  fi
  rm -f "$TMP_DUMP"
fi

# ── Gate de inmutabilidad (v0.8.3, pathspec actualizado a Fase 0) ──
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue

  # Deleción de branch remoto: no hay nada que verificar.
  if is_zero_sha "$local_sha"; then
    continue
  fi

  # Push de branch nuevo sin upstream (remote_sha todo-ceros): usamos el
  # merge-base con HEAD local; si no existe, warn y seguimos.
  BASE=""
  if is_zero_sha "$remote_sha"; then
    BASE="$(git -C "$PROJECT" merge-base "$local_sha" HEAD 2>/dev/null || true)"
    if [ -z "$BASE" ]; then
      echo "WARN: [pre-push] branch nuevo sin merge-base con HEAD; no se puede verificar ($local_ref)" >&2
      continue
    fi
  else
    BASE="$(git -C "$PROJECT" merge-base "$local_sha" "$remote_sha" 2>/dev/null || true)"
    if [ -z "$BASE" ]; then
      echo "ERROR: [pre-push] no se pudo calcular merge-base para $local_ref" >&2
      FAILED=1
      continue
    fi
  fi

  # Diff congelado del rango que se está pusheando, EXCLUYENDO el dump
  # (artefacto derivado; mismo pathspec que el seal y el pre-commit).
  DIFF_TEXT="$(git -C "$PROJECT" diff "$BASE".."$local_sha" -- . ':(exclude)db/teamdb/team.dump.sql' 2>/dev/null || true)"
  if [ -z "$DIFF_TEXT" ]; then
    # Sin cambios (fuera del dump) entre base y local_sha: nada que verificar.
    continue
  fi
  PUSH_HASH="$(printf '%s' "$DIFF_TEXT" | shasum -a 256 | cut -c1-16)"

  LAST_TREE_HASH=$(sqlite3 "$DB" "SELECT tree_hash FROM receipts WHERE tree_hash IS NOT NULL AND tree_hash != '' ORDER BY ts DESC LIMIT 1" 2>/dev/null || echo "")
  if [ -z "$LAST_TREE_HASH" ]; then
    echo "ERROR: [pre-push] no hay receipt sellado (tree_hash) en teamdb." >&2
    echo "       Corré bash scripts/skalling-review.sh (o bash scripts/teamdb-seal-receipt.sh <task> <agent>) antes de pushear." >&2
    FAILED=1
    continue
  fi
  if [ "$LAST_TREE_HASH" != "$PUSH_HASH" ]; then
    echo "ERROR: [pre-push] el diff a publicar no coincide con el último receipt sellado." >&2
    echo "       recibido: $PUSH_HASH" >&2
    echo "       sellado : $LAST_TREE_HASH" >&2
    echo "       Re-revisá (bash scripts/skalling-review.sh) y re-sellá antes de pushear." >&2
    FAILED=1
    continue
  fi
  echo "OK: [pre-push] $local_ref coincide con el receipt sellado ($PUSH_HASH)"
done

if [ "$FAILED" = "1" ]; then
  echo "ERROR: [pre-push] push bloqueado (fail-closed)" >&2
  exit 1
fi
exit 0
