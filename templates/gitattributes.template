# Git Attributes para Skalling — collaborative memory
#
# Este archivo define cómo git maneja conflictos en `.opencode/`.
# Vive en `.opencode/.gitattributes` para aplicarse solo a archivos de Skalling.

# ────────────────────────────────────────────────────────────────────────────
# ESTADO DEL WORKFLOW — proteger contra ciclos concurrentes
# ────────────────────────────────────────────────────────────────────────────

# workflow.json: solo UN ciclo activo a la vez. Si dos devs intentan,
# el segundo DEBE resolver manualmente (no se puede auto-mergear).
# Lock = bloquea el merge y obliga a hablar con el otro dev.
.opencode/state/workflow.json merge=lock

# ────────────────────────────────────────────────────────────────────────────
# BUNDLE OKF — append-friendly y regeneración trivial
# ────────────────────────────────────────────────────────────────────────────

# log.md: append-only. union = conserva ambas líneas.
.opencode/context/log.md merge=union

# index.md: regenerable. union = concatena ambos índices (Pau puede deduplicar después).
.opencode/context/index.md merge=union

# README.md del bundle: regenerable, mismo tratamiento.
.opencode/context/README.md merge=union

# ────────────────────────────────────────────────────────────────────────────
# CONCEPT DOCS — mismo nombre = conflicto a resolver
# ────────────────────────────────────────────────────────────────────────────

# Si dos devs crean `<mismo-nombre>.md` con distinto contenido,
# git NO puede auto-merge. Resolución: leer ambos, quedarse con el más completo,
# o renombrar uno (supersedes).

# Para los subdirectorios de concept docs, usar text normal pero con tip explícito:
.opencode/context/**/*.md text eol=lf
.opencode/context/**/*.md whitespace=-trailing-space

# ────────────────────────────────────────────────────────────────────────────
# CHANGES (SDD) — aislado por feature, conflicto solo si mismo slug
# ────────────────────────────────────────────────────────────────────────────

.opencode/changes/**/*.md text eol=lf
.opencode/changes/**/*.md whitespace=-trailing-space

# Si dos devs trabajan en el MISMO feature-slug, los archivos
# proposal/spec/design/tasks van a entrar en conflicto.
# Resolución: serializar el trabajo en ese feature (uno espera al otro).

# ────────────────────────────────────────────────────────────────────────────
# PROJECT.YAML — regenerable desde stack detection
# ────────────────────────────────────────────────────────────────────────────

# project.yaml es data auto-generada. union = combinación simple.
# Si hay conflicto, regenerar con `/skalling-refresh`.
.opencode/project.yaml merge=union

# ────────────────────────────────────────────────────────────────────────────
# OTROS ARCHIVOS
# ────────────────────────────────────────────────────────────────────────────

# constitution.md (si hay override per-project): proteger contra cambios accidentales
.opencode/context/constitucion.md merge=lock

# AGENTS.md raíz: regenerable, union está bien
/AGENTS.md merge=union

# Doc pública: manual merge si hay conflicto (es código, no se auto-mergea)
/docs/**/*.md text eol=lf

# ────────────────────────────────────────────────────────────────────────────
# TEAMDB SQL DUMPS — append-friendly
# ────────────────────────────────────────────────────────────────────────────

# data_*.sql: dumps de sqlite (conceptos/decisiones/etc). Cada INSERT es
# idempotente, así que union = "conservar ambas líneas de INSERT".
# El import filtra duplicados y maneja conflictos con warnings.
.opencode/context/teamdb/data_*.sql merge=union
